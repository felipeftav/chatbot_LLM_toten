# Chave(s) de API do Google Gemini (separe por vírgula para balanceamento de carga/fallback)
GEMINI_API_KEYS="SUA_CHAVE_GEMINI_AQUI"

# (Opcional) URL de conexão do PostgreSQL (Render, Supabase, etc.)
# Deixe comentado caso queira rodar localmente sem banco de dados
# DATABASE_URL="postgresql://usuario:senha@host:5432/database"

# (Opcional) Voz prioritária do Edge-TTS (padrão: pt-BR-ThalitaMultilingualNeural)
# Opções válidas: pt-BR-ThalitaMultilingualNeural, pt-BR-AntonioNeural, pt-BR-FranciscaNeural
TTS_VOICE="pt-BR-ThalitaMultilingualNeural"